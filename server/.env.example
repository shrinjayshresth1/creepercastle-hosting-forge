# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/creepercastle

# ─── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
ACCESS_TOKEN_SECRET=replace_with_64_byte_hex_secret
REFRESH_TOKEN_SECRET=replace_with_different_64_byte_hex_secret
STEP_TOKEN_SECRET=replace_with_another_64_byte_hex_secret

# ─── SMTP (Self-hosted / cPanel) ─────────────────────────────────────────────
# Port 465 = implicit SSL (SMTP_SECURE=true)
# Port 587 = STARTTLS (SMTP_SECURE=false)
SMTP_HOST=mail.flexeere.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@flexeere.net
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@flexeere.net

# ─── Fast2SMS ─────────────────────────────────────────────────────────────────
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=CREEPS

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://creepercastle.cloud

# ─── App URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://new.creepercastle.cloud
BACKEND_URL=https://new.creepercastle.cloud

# ─── HDFC SmartGateway ────────────────────────────────────────────────────────
# UAT base URL: https://smartgatewayuat.hdfcbank.com
# Production base URL: https://smartgateway.hdfcbank.com
HDFC_MERCHANT_ID=SG1620
HDFC_KEY_UUID=key_c0c9f30e906a48d88d13512ea7da884a
HDFC_PAYMENT_PAGE_CLIENT_ID=hdfcmaster
HDFC_BASE_URL=https://smartgatewayuat.hdfcbank.com
# Store keys as single-line with \n — the app converts them back to real newlines
HDFC_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
HDFC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
